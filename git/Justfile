# git 모듈: 모든 지식 저장소와 루트 저장소에 걸친 일괄 git 작업(최신 받기, 푸시, 상태).
# 모듈의 명령은 모듈 파일이 있는 디렉토리가 아니라 루트 저장소에서 실행한다.
set working-directory := '..'

# 인자 없이 `just git`만 부르면 명령 목록을 보여 준다. 첫 명령인 `pull`이 기본으로 실행되어 저장소가 바뀌지 않게 한다.
[private]
default:
    @"{{just_executable()}}" --justfile "{{source_file()}}" --list

# 저장소를 순회하고 상태를 판정하는 공통 부분은 lib.sh에 있다. 레시피가 읽어 쓴다. push도 같은 함수를 쓴다.

# pull: 루트 저장소와 모든 지식 저장소를 fast-forward로만 최신으로 올린다. 어떤 저장소도 커밋하거나 스테이징하지 않는다.
# 루트 저장소를 먼저 받는다(그래야 새로 등록된 지식 저장소가 목록에 든다). 그 뒤 지식 저장소를 하나씩 받는다.
# 모든 저장소는 fetch한다. 그다음 올릴 수 있는 곳만 올린다.
# - 지식 저장소는 추적 브랜치(.gitmodules에 기록된 것)에 있을 때만 올린다. 다른 브랜치에 있으면 fetch만 한다.
# - 루트 저장소는 현재 브랜치를 origin의 같은 이름 브랜치로 올린다.
# - fast-forward가 안 되는 곳(로컬 커밋이 갈라짐, 받아 올 변경과 겹치는 미커밋 변경)은 건드리지 않고 건너뛴 뒤 이유를 보고한다.
# 한 저장소가 건너뛰어지거나 실패해도 나머지를 계속 처리하고, 끝에 저장소별 결과를 요약한다.
# 건너뜀은 정상 결과라 종료 코드는 0이다. fetch 같은 실패가 있으면 끝까지 처리한 뒤 1로 끝난다.

# 루트 저장소와 모든 지식 저장소를 fast-forward로 최신으로 받는다.
[no-exit-message]
pull:
    #!/usr/bin/env sh
    # 한 저장소의 문제로 나머지가 멈추지 않도록 -e는 쓰지 않는다. 실패할 수 있는 명령은 그때마다 직접 처리한다.
    set -u
    . "{{source_directory()}}/lib.sh"

    updated=
    unchanged=
    skipped=
    failed=
    advanced=
    need_setup=0

    # record <updated|unchanged|skipped|failed> <표시 이름> [상세]
    record() {
        line=$2
        if [ -n "${3:-}" ]; then
            line="$line — $3"
        fi
        case $1 in
            updated) updated="$updated$line$NL" ;;
            unchanged) unchanged="$unchanged$line$NL" ;;
            skipped) skipped="$skipped$line$NL" ;;
            failed) failed="$failed$line$NL" ;;
        esac
    }

    # pull_one <경로> <표시 이름> <서브모듈 이름>
    # 서브모듈 이름이 비어 있으면(루트 저장소) 현재 브랜치를 origin의 같은 이름 브랜치로 올린다.
    # 지식 저장소는 추적 브랜치에 있을 때만 올린다. 추적 브랜치는 fetch 뒤에 정한다(.gitmodules에 기록이 없으면
    # 원격의 기본 브랜치인 origin/HEAD가 추적 브랜치인데, fetch가 이를 만들거나 고치는지는 git 버전과 설정에 달려 있다.
    # 그래서 fetch 뒤의 값을 읽고, 끝내 알 수 없으면 올리지 않고 건너뛴다). 결과는 record로 남기고 항상 0으로 돌아온다.
    pull_one() {
        po_path=$1
        po_label=$2
        po_name=$3

        if ! repo_initialized "$po_path"; then
            need_setup=1
            record skipped "$po_label" "초기화되지 않았다. just setup으로 초기화하세요"
            return 0
        fi
        if ! git -C "$po_path" remote get-url origin >/dev/null 2>&1; then
            record skipped "$po_label" "origin 원격이 없다"
            return 0
        fi
        # 서브모듈의 서브모듈까지 따라가 받지 않는다(루트의 fetch가 지식 저장소를 건드리지 않게).
        if ! po_err=$(git -C "$po_path" fetch --quiet --recurse-submodules=no origin 2>&1); then
            record failed "$po_label" "fetch에 실패했다: $(first_line "$po_err")"
            return 0
        fi

        po_track=
        if [ -n "$po_name" ]; then
            po_track=$(tracking_branch "$po_name" "$po_path")
        fi
        po_branch=$(repo_branch "$po_path")
        if [ -z "$po_branch" ]; then
            record skipped "$po_label" "detached HEAD($(git -C "$po_path" rev-parse --short HEAD 2>/dev/null))라 fetch만 했다"
            return 0
        fi
        if [ -n "$po_name" ] && [ -z "$po_track" ]; then
            record skipped "$po_label" "추적 브랜치를 알 수 없어 fetch만 했다. .gitmodules에 branch가 없고 원격의 기본 브랜치도 알 수 없다"
            return 0
        fi
        if [ -n "$po_track" ] && [ "$po_branch" != "$po_track" ]; then
            record skipped "$po_label" "추적 브랜치($po_track)가 아니라 $po_branch 브랜치에 있어 fetch만 했다"
            return 0
        fi
        po_target=${po_track:-$po_branch}
        po_remote_ref=refs/remotes/origin/$po_target
        if ! po_remote=$(git -C "$po_path" rev-parse --verify --quiet "$po_remote_ref"); then
            record skipped "$po_label" "원격에 $po_target 브랜치가 없다"
            return 0
        fi
        if ! po_head=$(git -C "$po_path" rev-parse --verify --quiet HEAD); then
            record skipped "$po_label" "커밋이 아직 없다"
            return 0
        fi

        if [ "$po_head" = "$po_remote" ]; then
            record unchanged "$po_label"
            return 0
        fi
        if git -C "$po_path" merge-base --is-ancestor "$po_remote" "$po_head"; then
            # 원격이 로컬의 이력 안에 있다: 받을 것이 없다. 로컬이 앞서 있을 뿐이다.
            po_ahead=$(git -C "$po_path" rev-list --count "$po_remote..$po_head" 2>/dev/null) || po_ahead=?
            record unchanged "$po_label" "받을 것이 없다(푸시하지 않은 로컬 커밋 ${po_ahead}개)"
            return 0
        fi
        if ! git -C "$po_path" merge-base --is-ancestor "$po_head" "$po_remote"; then
            po_counts=$(git -C "$po_path" rev-list --left-right --count "$po_head...$po_remote" 2>/dev/null) || po_counts="?	?"
            po_ahead=${po_counts%%"$TAB"*}
            po_behind=${po_counts#*"$TAB"}
            record skipped "$po_label" "로컬 커밋 ${po_ahead}개와 원격 커밋 ${po_behind}개가 갈라져 fast-forward가 안 된다"
            return 0
        fi

        # fast-forward가 가능하다. 받아 올 변경과 겹치는 로컬 작업이 있으면 git이 아무것도 바꾸지 않고 거부해야 한다.
        # 사용자의 git 설정과 기본값이 그 약속을 깨지 않도록 명령줄에서 고정한다(명령줄 옵션이 설정보다 우선한다).
        # - --no-autostash: merge.autoStash나 branch.<이름>.mergeOptions가 켜져 있으면 미커밋 변경을 스태시했다가 다시 적용해
        #   겹치는 변경이 조용히 섞이거나 충돌 표시와 함께 남는다.
        # - --no-overwrite-ignore: 기본은 .gitignore가 제외한 파일을 받아 올 파일로 덮어쓴다. 되돌릴 수 없는 로컬 작업이다.
        # - -c submodule.recurse=false: 서브모듈 작업 트리를 건드리지 않는다.
        # 거부 이유를 읽으므로 메시지 언어를 고정한다.
        if po_out=$(LC_ALL=C git -C "$po_path" -c submodule.recurse=false merge --ff-only --no-autostash --no-overwrite-ignore --quiet "$po_remote_ref" 2>&1); then
            po_count=$(git -C "$po_path" rev-list --count "$po_head..$po_remote" 2>/dev/null) || po_count=?
            record updated "$po_label" "$(printf %.7s "$po_head")..$(printf %.7s "$po_remote"), 커밋 ${po_count}개"
            if [ "$po_path" != . ]; then
                advanced="$advanced$po_path$NL"
            fi
            return 0
        fi
        po_files=$(printf '%s\n' "$po_out" | sed -n "s/^$TAB//p" | tr '\n' ' ')
        case $po_out in
            *"local changes"*"would be overwritten"*)
                record skipped "$po_label" "받아 올 변경과 같은 파일에 미커밋 변경이 있어 fast-forward가 거부되었다: ${po_files% }"
                ;;
            *"untracked working tree files would be overwritten"*)
                record skipped "$po_label" "받아 올 파일과 겹치는 추적하지 않거나 무시되는 파일이 있어 fast-forward가 거부되었다: ${po_files% }"
                ;;
            *)
                record skipped "$po_label" "fast-forward에 실패했다: $(first_line "$po_out")"
                ;;
        esac
        return 0
    }

    # --- 루트 저장소부터 ---
    echo "받는 중: $ROOT_LABEL"
    pull_one . "$ROOT_LABEL" "" </dev/null

    # --- 지식 저장소. 루트를 받은 뒤의 .gitmodules를 읽는다 ---
    list_failed=0
    if ! repos=$(knowledge_repos </dev/null); then
        list_failed=1
        repos=
    fi
    while IFS="$TAB" read -r repo_path repo_name; do
        [ -n "$repo_path" ] || continue
        echo "받는 중: $repo_path"
        pull_one "$repo_path" "$repo_path" "$repo_name" </dev/null
    done <<EOF
    $repos
    EOF

    # --- 요약 ---
    echo
    echo "== 요약 =="
    print_group 갱신됨 "$updated"
    print_group "변화 없음" "$unchanged"
    print_group 건너뜀 "$skipped"
    print_group 실패 "$failed"

    # 지식 저장소가 올라가면 루트의 서브모듈 포인터가 달라진다. 커밋하지 않고 남겨 두므로, 무엇이 바뀌었는지 알린다.
    pointers=
    while IFS= read -r adv_path; do
        [ -n "$adv_path" ] || continue
        if pointer_changed "$adv_path"; then
            pointers="$pointers$adv_path$NL"
        fi
    done <<EOF
    $advanced
    EOF
    if [ -n "$pointers" ]; then
        echo
        echo "루트 저장소의 서브모듈 포인터가 바뀌었습니다. 커밋하지 않았습니다. 확인한 뒤 직접 커밋하세요:"
        printf '%s' "$pointers" | sed 's/^/  /'
    fi
    if [ "$need_setup" = 1 ]; then
        echo
        echo "초기화되지 않은 서브모듈이 있습니다. just setup으로 초기화하세요."
    fi

    if [ -n "$failed" ] || [ "$list_failed" = 1 ]; then
        exit 1
    fi

# push: 이미 커밋된 것만 올린다. 지식 저장소를 먼저 하나씩 올리고, 모두 성공하면 루트 저장소를 올린다.
# 순서와 중단 조건이 이 명령의 약속이다.
# - 지식 저장소: 올릴 커밋이 있는 곳만 현재 브랜치를 origin의 같은 이름 브랜치로 올린다. 원격에 없는 브랜치는 만든다.
#   올릴 것이 없는 곳은 건드리지 않는다(원격에 접속하지도 않는다). 하나가 실패해도 나머지는 계속 올린다.
# - 루트 저장소: 지식 저장소가 하나라도 실패했거나, 이번에 올라가는 루트 커밋 가운데 하나라도 원격에서 확인되지 않는 서브모듈 커밋을
#   가리키면 올리지 않는다(원격의 루트 저장소가 원격에 없는 커밋을 가리키게 되기 때문이다).
# - 미커밋 변경은 올라가지 않는다. 그런 저장소는 올리기 전에 목록으로 알린다. 어떤 저장소도 커밋하거나 스테이징하지 않는다.
# 끝에 저장소별 결과(푸시됨, 올릴 것 없음, 건너뜀, 실패와 그 이유)를 요약한다. 실패가 있으면 1로 끝난다.
# 건너뜀(detached HEAD 등)은 실패가 아니라서 종료 코드는 0이다. 그 저장소에 올리지 않은 커밋이 남으면 요약 끝에서 따로 알린다.
# 그 커밋을 루트 저장소가 가리키면 루트 푸시가 실패로 끝나므로, 원격에 없는 커밋을 가리키는 일은 없다.
#
# 푸시 관문: 올리기 전에 스크립트 검사(`just onto validate`)를 돌린다. 오류가 있으면 아무것도 올리지 않고 요약 없이 1로 끝난다.
# 경고만 있으면 경고를 보여 주고 올린다. 검사는 커밋된 내용이 아니라 작업 트리를 본다. 미커밋 변경이 있는 저장소의 목록은 검사 전에 이미 보였으므로 검사 결과와 함께 보인다.
# - 이 관문이 검사 관문의 전부다. git 훅과 CI는 두지 않는다.
# - 루트 기본 규칙(`onto/rules.yaml`)의 `push-gate`의 `enabled`가 false이면 검사하지 않고 올린다. 지식 저장소의 규칙으로는 끌 수 없다(덮어쓰려 하면 스크립트 검사가 오류로 막는다).
#   값을 읽지 못하면 켜진 것으로 본다. 규칙 파일이 틀렸다면 검사도 같은 이유로 막는다.
# - 강제 옵션(`--force`, `-f`)을 주면 오류가 있어도 올린다. 검사는 그대로 돌려 넘기는 문제를 보여 주고, 관문을 넘겼다는 사실을 출력에 남긴다(올린 뒤에도 다시 알린다).
#   git의 강제 푸시가 아니다. 원격의 이력을 덮어쓰지 않고, 원격이 앞서 있으면 그대로 거부된다.
# - 관문이 꺼져 있거나 넘겨져도 아래의 순서와 중단 조건은 그대로다.
# - 검사는 루트 저장소의 Justfile(`just onto validate`)로 돌린다. 실행 위치와 상관없이 루트 저장소를 검사하며, 지식 저장소 안에서 도는 검사가 아니다(항상 루트의 최신 공통 어휘로 돈다).

# 루트 저장소와 모든 지식 저장소의 커밋한 것을 푸시한다. 지식 저장소가 먼저다. 먼저 스크립트 검사를 돌려 오류가 있으면 아무것도 올리지 않는다: just git push [--force]
[no-exit-message]
[positional-arguments]
push *args:
    #!/usr/bin/env sh
    # 한 저장소의 문제로 나머지가 멈추지 않도록 -e는 쓰지 않는다. 실패할 수 있는 명령은 그때마다 직접 처리한다.
    set -u
    . "{{source_directory()}}/lib.sh"

    # 인자는 강제 옵션 하나뿐이다. 알 수 없는 인자는 아무것도 하기 전에 거부한다(오타가 강제 옵션처럼 넘어가지 않게).
    force=0
    for arg in "$@"; do
        case $arg in
            --force | -f) force=1 ;;
            *)
                echo "오류: 알 수 없는 인자입니다: $arg. 사용법: just git push [--force]" >&2
                echo "  --force, -f: 스크립트 검사에 오류가 있어도 푸시한다(푸시 관문을 넘긴다). git의 강제 푸시가 아니다." >&2
                exit 1
                ;;
        esac
    done

    pushed=
    nothing=
    skipped=
    failed=
    failed_repos=
    leftover=
    need_setup=0
    list_failed=0

    # record <pushed|nothing|skipped|failed> <표시 이름> [상세]
    record() {
        line=$2
        if [ -n "${3:-}" ]; then
            line="$line — $3"
        fi
        case $1 in
            pushed) pushed="$pushed$line$NL" ;;
            nothing) nothing="$nothing$line$NL" ;;
            skipped) skipped="$skipped$line$NL" ;;
            failed) failed="$failed$line$NL" ;;
        esac
    }

    # git이 푸시를 거부하거나 실패한 이유를 한 줄로 추린다. 거부 줄(` ! [rejected] …`), fatal, error 순으로 찾는다.
    push_failure_reason() {
        pf_reason=$(printf '%s\n' "$1" | grep -m1 -E '^ *! ' || true)
        [ -n "$pf_reason" ] || pf_reason=$(printf '%s\n' "$1" | grep -m1 -E '^(fatal|error):' || true)
        [ -n "$pf_reason" ] || pf_reason=$(first_line "$1")
        printf '%s\n' "$pf_reason" | sed 's/^ *//; s/  */ /g'
    }

    # push_one <경로> <표시 이름>
    # 경로 `.`는 루트 저장소다. 결과는 record로 남기고 항상 0으로 돌아온다.
    push_one() {
        po_path=$1
        po_label=$2

        if ! repo_initialized "$po_path"; then
            need_setup=1
            record skipped "$po_label" "초기화되지 않았다. just setup으로 초기화하세요"
            return 0
        fi
        if ! git -C "$po_path" remote get-url origin >/dev/null 2>&1; then
            record skipped "$po_label" "origin 원격이 없다"
            # 원격이 없으니 이 저장소의 커밋은 모두 원격에 없다(개수는 알 수 없다)
            if git -C "$po_path" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
                leftover="$leftover$po_label: origin 원격이 없어 커밋이 모두 원격에 없다$NL"
            fi
            return 0
        fi
        if ! git -C "$po_path" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
            record nothing "$po_label" "커밋이 아직 없다"
            return 0
        fi
        po_branch=$(repo_branch "$po_path")
        if ! po_count=$(repo_unpushed_count "$po_path" "$po_branch"); then
            record failed "$po_label" "푸시하지 않은 커밋 수를 세지 못했다"
            if [ "$po_path" != . ]; then
                failed_repos="$failed_repos$po_path "
            fi
            return 0
        fi
        if [ "$po_count" = 0 ]; then
            record nothing "$po_label"
            return 0
        fi
        if [ -z "$po_branch" ]; then
            record skipped "$po_label" "detached HEAD($(git -C "$po_path" rev-parse --short HEAD 2>/dev/null))라 푸시하지 않았다. 원격에 없는 커밋 ${po_count}개가 있다. 브랜치로 옮긴 뒤 푸시하세요"
            leftover="$leftover$po_label: 커밋 ${po_count}개$NL"
            return 0
        fi

        if [ "$po_path" = . ]; then
            # 루트 저장소는 지식 저장소가 모두 올라간 뒤에, 가리키는 커밋이 원격에 있을 때만 올린다.
            if [ "$list_failed" = 1 ]; then
                record skipped "$po_label" "지식 저장소의 목록을 읽지 못해 어느 저장소를 먼저 올려야 하는지 알 수 없어 푸시하지 않았다"
                leftover="$leftover$po_label: 커밋 ${po_count}개$NL"
                return 0
            fi
            if [ -n "$failed_repos" ]; then
                record skipped "$po_label" "지식 저장소 푸시에 실패해 푸시하지 않았다: ${failed_repos% }"
                leftover="$leftover$po_label: 커밋 ${po_count}개$NL"
                return 0
            fi
            if ! po_dangling=$(unpublished_pointers "$po_branch"); then
                record failed "$po_label" "올라갈 커밋이 가리키는 서브모듈 커밋을 읽지 못해 푸시하지 않았다"
                return 0
            fi
            if [ -n "$po_dangling" ]; then
                record failed "$po_label" "원격에서 확인되지 않는 서브모듈 커밋을 가리켜 푸시하지 않았다: $(printf '%s' "$po_dangling" | tr '\n' ';' | sed 's/;/; /g; s/; $//')"
                return 0
            fi
        fi

        po_new=
        if ! repo_has_remote_branch "$po_path" "$po_branch"; then
            po_new=" (원격에 새로 만듦)"
        fi
        echo "푸시 중: $po_label ($po_branch)"
        # 현재 브랜치를 같은 이름의 원격 브랜치로 올린다. 사용자의 git 설정이 올리는 것을 바꾸지 못하도록 명령줄에서 고정한다.
        # - 브랜치를 refspec으로 명시한다: push.default나 추적 브랜치 설정이 대상을 바꾸지 못한다.
        # - --no-follow-tags: push.followTags가 켜져 있으면 올리는 커밋에 닿는 주석 태그도 함께 올라간다. 커밋한 브랜치만 올린다.
        # - --no-recurse-submodules: push.recurseSubmodules가 서브모듈을 따라 올리지 못하게 한다(순서는 이 레시피가 정한다).
        # 이유를 읽으므로 메시지 언어를 고정한다.
        if po_out=$(LC_ALL=C git -C "$po_path" push --no-follow-tags --no-recurse-submodules origin "refs/heads/$po_branch:refs/heads/$po_branch" 2>&1 </dev/null); then
            record pushed "$po_label" "$po_branch$po_new, 커밋 ${po_count}개"
        else
            record failed "$po_label" "푸시에 실패했다: $(push_failure_reason "$po_out")"
            if [ "$po_path" != . ]; then
                failed_repos="$failed_repos$po_path "
            fi
        fi
        return 0
    }

    # 올리기 전에 미커밋 변경이 있는 저장소를 알린다. 그 변경은 올라가지 않는다.
    # scan_uncommitted <경로> <표시 이름>
    scan_uncommitted() {
        repo_initialized "$1" || return 0
        if ! su_changes=$(repo_changes "$1"); then
            uncommitted="$uncommitted$2: 미커밋 변경을 확인하지 못했다$NL"
        elif [ -n "$su_changes" ]; then
            uncommitted="$uncommitted$2: $(printf '%s\n' "$su_changes" | wc -l | tr -d ' ')개$NL"
        fi
    }

    if ! repos=$(knowledge_repos </dev/null); then
        list_failed=1
        repos=
    fi

    # --- 미커밋 변경 보고 ---
    uncommitted=
    scan_uncommitted . "$ROOT_LABEL"
    while IFS="$TAB" read -r repo_path repo_name; do
        [ -n "$repo_path" ] || continue
        scan_uncommitted "$repo_path" "$repo_path" </dev/null
    done <<EOF
    $repos
    EOF
    if [ -n "$uncommitted" ]; then
        echo "미커밋 변경이 있는 저장소. 이 변경은 올라가지 않습니다(커밋한 것만 올립니다):"
        printf '%s' "$uncommitted" | sed 's/^/  /'
        echo
    fi

    # --- 푸시 관문 ---
    # 여기까지는 아무것도 바꾸지 않았다. 푸시 전에 스크립트 검사를 돌려 오류가 있으면, 요약 없이 여기서 `exit 1`로 끝내
    # 어떤 저장소도 올라가지 않는다. 아래 순서(지식 저장소가 먼저, 모두 성공하면 루트)와 중단 조건은 관문이 꺼져 있거나 넘겨져도 그대로다.
    # 루트 저장소의 Justfile을 `--justfile`로 가리켜 부른다. 이 레시피를 부른 실행 위치(`-d`)나 하위 디렉토리와 상관없이 루트를 검사한다.
    gate_just="{{just_executable()}}"
    gate_justfile="{{justfile()}}"
    gate_bypassed=0

    # 루트 기본 규칙의 `push-gate`의 `enabled`. 셸에는 JSON을 읽는 표준 도구가 없고 `jq`에 기대지 않으려고, `onto rules`가 낸 JSON에서
    # 최상위 `push-gate` 객체의 `enabled` 줄만 읽는다(출력은 들여쓰기 2칸의 `json.dumps`라 줄의 모양이 정해져 있다). 못 읽으면 켜진 것으로 본다.
    # 규칙 파일이 틀려 `rules`가 실패하는 경우도 켜진 것으로 보고 검사를 돌린다. 검사가 같은 이유를 알리며 막는다(그 오류를 여기서 두 번 보이지 않는다).
    gate_enabled=true
    if gate_rules=$("$gate_just" --justfile "$gate_justfile" onto rules </dev/null 2>/dev/null); then
        gate_value=$(printf '%s\n' "$gate_rules" | awk '
            /^  "push-gate": *\{/ { in_gate = 1; next }
            in_gate && /^  \}/ { exit }
            in_gate && /"enabled":/ { gsub(/[ ,]/, "", $2); print $2; exit }')
        if [ "$gate_value" = false ]; then
            gate_enabled=false
        fi
    fi

    if [ "$gate_enabled" = false ]; then
        echo "푸시 관문: 꺼져 있어 스크립트 검사를 하지 않았습니다(루트 기본 규칙 onto/rules.yaml의 push-gate)"
        echo
    else
        echo "푸시 관문: 스크립트 검사 중(just onto validate)"
        # 검사의 출력은 그대로 보인다: 문제는 한 줄에 하나(표준 출력), 요약은 표준 오류. 오류가 있거나 검사를 끝내지 못하면 0이 아닌 값이다.
        "$gate_just" --justfile "$gate_justfile" onto validate </dev/null
        gate_status=$?
        if [ "$gate_status" = 0 ]; then
            echo "푸시 관문: 스크립트 검사에 오류가 없습니다"
            echo
        elif [ "$force" = 1 ]; then
            gate_bypassed=1
            echo "푸시 관문을 강제로 넘깁니다: 스크립트 검사에 오류가 있거나 검사를 끝내지 못했지만(종료 코드 $gate_status) 강제 옵션을 줬으므로 푸시합니다"
            echo
        else
            echo "푸시 관문: 스크립트 검사에 오류가 있어 아무것도 푸시하지 않았습니다(종료 코드 $gate_status). 위의 문제를 고친 뒤 다시 푸시하세요." >&2
            echo "알고서 넘어가려면 강제 옵션을 주세요: just git push --force" >&2
            exit 1
        fi
    fi

    # --- 지식 저장소를 먼저 ---
    while IFS="$TAB" read -r repo_path repo_name; do
        [ -n "$repo_path" ] || continue
        push_one "$repo_path" "$repo_path" </dev/null
    done <<EOF
    $repos
    EOF

    # --- 모두 성공한 뒤에 루트 저장소 ---
    push_one . "$ROOT_LABEL" </dev/null

    # --- 요약 ---
    echo
    echo "== 요약 =="
    print_group 푸시됨 "$pushed"
    print_group "올릴 것 없음" "$nothing"
    print_group 건너뜀 "$skipped"
    print_group 실패 "$failed"
    # 건너뛰어 올리지 못한 커밋은 종료 코드에 드러나지 않으므로 따로 알린다.
    if [ -n "$leftover" ]; then
        echo
        echo "주의: 건너뛴 저장소에 푸시하지 않은 커밋이 남아 있습니다. 이 커밋은 원격에 없습니다:"
        printf '%s' "$leftover" | sed 's/^/  /'
    fi
    if [ "$need_setup" = 1 ]; then
        echo
        echo "초기화되지 않은 서브모듈이 있습니다. just setup으로 초기화하세요."
    fi
    # 강제 옵션으로 넘긴 관문은 푸시 결과 뒤에서도 알린다. 출력이 길어져 앞의 알림이 스크롤로 사라져도 남는다.
    if [ "$gate_bypassed" = 1 ]; then
        echo
        echo "주의: 푸시 관문을 강제로 넘겼습니다. 스크립트 검사에 오류가 남은 채로 푸시했습니다. 걸린 문제는 위의 푸시 관문 보고에 있습니다."
    fi

    if [ -n "$failed" ] || [ "$list_failed" = 1 ]; then
        exit 1
    fi

# status: 루트 저장소와 지식 저장소별로 현재 브랜치, 미커밋 변경, 미푸시 커밋 수, 뒤처진 커밋 수를 한 줄씩 보여 준다.
# 원격에 접속하지 않는다. 미푸시와 뒤처짐은 origin의 같은 이름 브랜치와 비교하고(push가 올리는 곳이다), 마지막으로 받은(fetch) 원격 정보 기준이다.
# 아무것도 바꾸지 않고, 인덱스도 새로 쓰지 않는다.

# 루트 저장소와 지식 저장소별 상태를 요약한다.
[no-exit-message]
status:
    #!/usr/bin/env sh
    set -u
    . "{{source_directory()}}/lib.sh"
    # 상태를 읽으며 인덱스를 새로 쓰지 않는다
    GIT_OPTIONAL_LOCKS=0
    export GIT_OPTIONAL_LOCKS

    # show_status <경로> <표시 이름>
    show_status() {
        ss_path=$1
        ss_label=$2
        if ! repo_initialized "$ss_path"; then
            echo "$ss_label: 초기화되지 않았다. just setup으로 초기화하세요"
            return 0
        fi
        ss_branch=$(repo_branch "$ss_path")
        if [ -n "$ss_branch" ]; then
            ss_where="브랜치 $ss_branch"
        else
            ss_where="브랜치 (detached HEAD $(git -C "$ss_path" rev-parse --short HEAD 2>/dev/null))"
        fi
        if ss_changes=$(repo_changes "$ss_path"); then
            if [ -z "$ss_changes" ]; then
                ss_dirty="미커밋 없음"
            else
                ss_dirty="미커밋 $(printf '%s\n' "$ss_changes" | wc -l | tr -d ' ')개"
            fi
        else
            ss_dirty="미커밋 ?"
        fi
        ss_unpushed=$(repo_unpushed_count "$ss_path" "$ss_branch" 2>/dev/null) || ss_unpushed=?
        # 원격에 같은 이름의 브랜치가 없으면(새 작업 브랜치) 원격의 어느 브랜치에도 없는 커밋을 미푸시로 센다. 뒤처짐은 알 수 없다.
        ss_note=
        if [ -n "$ss_branch" ] && ! repo_has_remote_branch "$ss_path" "$ss_branch"; then
            ss_note=" (원격에 $ss_branch 브랜치 없음)"
        fi
        ss_behind=$(repo_behind_count "$ss_path" "$ss_branch" 2>/dev/null) || ss_behind=-
        echo "$ss_label: $ss_where, $ss_dirty, 미푸시 $ss_unpushed$ss_note, 뒤처짐 $ss_behind"
    }

    show_status . "$ROOT_LABEL"
    pointers=$(pointer_changes)
    if [ -n "$pointers" ]; then
        echo "  서브모듈 포인터 변경(커밋하지 않음): $(printf '%s' "$pointers" | tr '\n' ' ' | sed 's/ $//')"
    fi

    list_failed=0
    if ! repos=$(knowledge_repos </dev/null); then
        list_failed=1
        repos=
    fi
    while IFS="$TAB" read -r repo_path repo_name; do
        [ -n "$repo_path" ] || continue
        show_status "$repo_path" "$repo_path" </dev/null
    done <<EOF
    $repos
    EOF

    echo
    echo "뒤처짐은 마지막으로 받은 원격 정보 기준입니다. 원격에 접속하지 않았습니다. 최신 정보로 보려면 just git pull을 실행하세요."
    if [ "$list_failed" = 1 ]; then
        exit 1
    fi
