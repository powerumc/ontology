# 공통 어휘: 모든 지식 저장소가 함께 쓰는 클래스와 관계의 정의.
# 네임스페이스는 위치와 무관한 고정값 하나다. 지식 저장소마다 사본이 있어도 같은 클래스와 관계를 가리킨다.
# frontmatter 키와 이 어휘의 대응은 context.jsonld가 정한다.
# 제목·날짜는 DCTERMS, 용어는 SKOS, 출처는 PROV-O를 쓴다.

@prefix onto: <https://onto.invalid/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://onto.invalid/vocab> a owl:Ontology ;
    rdfs:comment "모듈형 온톨로지 공통 어휘"@ko ;
    owl:versionInfo "0.1.0" .

# --- 클래스 ----------------------------------------------------------------

onto:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:comment "지식 저장소 하나가 다루는 프로젝트 그 자체. 페이지 없이 ontology.yaml에서 만들어지며 식별자는 project다. 자기가 쓰는 관계(dependsOn)도 ontology.yaml에 적는다."@ko .

onto:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "프로젝트를 이루는 시스템, 모듈, 서비스."@ko .

onto:Plan a owl:Class ;
    rdfs:label "Plan"@en ;
    rdfs:comment "앞으로 할 일을 정한 것. 스킬이 쓴 계획 문서에서 나온 것도 여기에 속한다."@ko .

onto:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    rdfs:comment "프로젝트에서 지켜야 하는 규칙이나 제약."@ko .

onto:Term a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Term"@en ;
    rdfs:comment "프로젝트에서 뜻을 정해 둔 용어."@ko .

onto:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    rdfs:comment "대안 가운데 하나를 고른 결정과 그 이유."@ko .

onto:Report a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:comment "구현한 결과를 기록한 것."@ko .

onto:Source a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Source"@en ;
    rdfs:comment "원본 문서를 가리키는 엔티티. 페이지를 따로 갖지 않고, 페이지의 derivedFrom 항목(경로와 해시)에서 컴파일이 만든다. 같은 경로라도 해시가 다르면 다른 엔티티다."@ko .

# --- 관계 ------------------------------------------------------------------
# 페이지에는 아래에 적은 방향(쓰는 쪽 → 가리키는 쪽)만 쓴다. 역방향은 추론으로만 생긴다(아래 "역관계").
# 추론은 하위 클래스(rdfs:subClassOf), 역관계(owl:inverseOf), 추이 관계(owl:TransitiveProperty) 세 규칙뿐이고,
# 어떤 클래스와 관계에 적용할지는 이 파일의 선언이 정한다. 추이 관계는 partOf 하나다. dependsOn은 추이 관계가 아니다.

onto:partOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "partOf"@en ;
    owl:inverseOf onto:hasPart ;
    rdfs:comment "A는 B의 일부다. 한 Component가 다른 Component나 Project의 일부라는 관계. Component → Component, Project. 추이 관계다: A가 B의 일부이고 B가 C의 일부이면 A는 C의 일부다."@ko .

onto:dependsOn a owl:ObjectProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:comment "A가 동작하려면 B가 필요하다. 직접 의존만 적는다. Component, Project → Component, Project. 추이 관계가 아니다: 간접 의존은 질의에서 경로로 구한다."@ko .

onto:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    owl:inverseOf onto:implementedBy ;
    rdfs:comment "이 구현 결과가 그 계획이나 결정을 실행했다. Report → Plan, Decision."@ko .

onto:governs a owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    owl:inverseOf onto:governedBy ;
    rdfs:comment "이 정책이 그 대상에 적용된다. Policy → Project, Component."@ko .

onto:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    owl:inverseOf onto:supersededBy ;
    rdfs:comment "새 것이 옛 것을 대체한다. 같은 클래스끼리."@ko .

onto:derivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "derivedFrom"@en ;
    rdfs:comment "이 페이지의 근거가 된 원본 문서. 모든 페이지 → Source. 페이지에는 경로와 git 해시를 가진 항목(path, hash)으로 쓰고, 컴파일이 Source로 바꾼다."@ko .

onto:about a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    rdfs:comment "이 페이지가 다루는 대상. Plan, Decision, Report, Term → Project, Component."@ko .

# --- 역관계 ------------------------------------------------------------------
# 페이지에는 쓰지 않는다(context.jsonld에 키가 없다). 추론이 위 관계의 방향을 뒤집어 만든다.
# 방향은 위 관계의 owl:inverseOf에 한 번만 적는다. owl:inverseOf는 대칭이라 반대쪽에도 같은 뜻이다.

onto:hasPart a owl:ObjectProperty ;
    rdfs:label "hasPart"@en ;
    rdfs:comment "partOf의 역. A가 B를 일부로 가진다. partOf가 추이 관계이므로 간접으로 가진 일부도 포함한다."@ko .

onto:implementedBy a owl:ObjectProperty ;
    rdfs:label "implementedBy"@en ;
    rdfs:comment "implements의 역. 이 계획이나 결정을 그 구현 결과가 실행했다."@ko .

onto:governedBy a owl:ObjectProperty ;
    rdfs:label "governedBy"@en ;
    rdfs:comment "governs의 역. 이 대상에 그 정책이 적용된다."@ko .

onto:supersededBy a owl:ObjectProperty ;
    rdfs:label "supersededBy"@en ;
    rdfs:comment "supersedes의 역. 옛 것을 새 것이 대체했다."@ko .

# --- 출처 ------------------------------------------------------------------
# 컴파일이 모든 엔티티에 적는다. 합쳐진 그래프에서 엔티티가 어느 지식 저장소에서 왔는지 질의로 가려내는 데 쓴다.
# 값은 그 지식 저장소의 이름(ontology.yaml의 name)이고, 교차 참조의 `<저장소 이름>`과 같다. 페이지에는 쓰지 않는다.

onto:repository a owl:DatatypeProperty ;
    rdfs:label "repository"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "이 엔티티가 온 지식 저장소의 이름. 컴파일이 적으며 페이지에는 쓰지 않는다."@ko .

# 지식 저장소가 선언한 하위 클래스(ontology.yaml의 classes)에 컴파일이 적는다. 엔티티의 출처인 onto:repository와 구분해,
# 엔티티를 지식 저장소로 묻는 질의에 클래스 선언이 섞이지 않게 한다.

onto:declaredIn a owl:DatatypeProperty ;
    rdfs:label "declaredIn"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "이 클래스를 선언한 지식 저장소의 이름. 컴파일이 적으며 엔티티가 아니라 지식 저장소가 선언한 하위 클래스에만 붙는다."@ko .

# 원본 문서의 기록. Source 엔티티가 가진다. 페이지의 derivedFrom 항목에서 컴파일이 적으며, 페이지에는 쓰지 않는다.

onto:sourcePath a owl:DatatypeProperty ;
    rdfs:label "sourcePath"@en ;
    rdfs:domain onto:Source ;
    rdfs:range xsd:string ;
    rdfs:comment "원본 문서의 경로. 그 문서가 있는 지식 저장소의 루트 기준이고 /로 구분한다."@ko .

onto:sourceHash a owl:DatatypeProperty ;
    rdfs:label "sourceHash"@en ;
    rdfs:domain onto:Source ;
    rdfs:range xsd:string ;
    rdfs:comment "페이지가 근거로 삼은 시점의 원본 문서의 git 해시(40자리 소문자 16진수)."@ko .
