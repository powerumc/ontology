{
  "@context": {
    "onto": "https://onto.invalid/vocab#",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "class": "@type",
    "Project": "onto:Project",
    "Component": "onto:Component",
    "Plan": "onto:Plan",
    "Policy": "onto:Policy",
    "Term": "onto:Term",
    "Decision": "onto:Decision",
    "Report": "onto:Report",
    "Source": "onto:Source",

    "title": "dcterms:title",
    "description": "dcterms:description",
    "date": { "@id": "dcterms:date", "@type": "xsd:date" },
    "aliases": "skos:altLabel",

    "partOf": { "@id": "onto:partOf", "@type": "@id" },
    "dependsOn": { "@id": "onto:dependsOn", "@type": "@id" },
    "implements": { "@id": "onto:implements", "@type": "@id" },
    "governs": { "@id": "onto:governs", "@type": "@id" },
    "supersedes": { "@id": "onto:supersedes", "@type": "@id" },
    "derivedFrom": { "@id": "onto:derivedFrom", "@type": "@id" },
    "about": { "@id": "onto:about", "@type": "@id" }
  }
}
