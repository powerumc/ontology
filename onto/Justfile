# onto 모듈: 온톨로지 도구를 부르는 얇은 진입점.
# 루트 저장소에서는 모듈로, 지식 저장소에서는 `.onto/Justfile`을 `just -f`로 직접 가리켜 쓴다.
# 어느 쪽이든 명령은 이 파일이 있는 디렉토리의 한 단계 위, 곧 그 저장소의 루트에서 실행한다.
set working-directory := '..'

# 명령의 인자를 `{{…}}`로 풀어 쓰지 않고 위치 인자(`"$@"`)로 도구에 그대로 넘긴다.
# 풀어 쓰면 SPARQL 질의의 꺾쇠, 중괄호, 따옴표, 세미콜론이 셸 문법으로 읽혀 깨진다.
set positional-arguments

# 온톨로지 도구를 실행하는 명령줄. `-P`는 현재 디렉토리를 모듈 검색 경로 맨 앞에 넣지 않는다.
# 지식 저장소 최상위의 `yaml.py`나 `types.py` 같은 파일이 도구의 의존성과 표준 라이브러리를 가리는 일을 막는다.
# 도구는 이 디렉토리 안의 uv 프로젝트(onto/pyproject.toml)로 자족적으로 돈다.
# 루트의 pyproject.toml과 가상환경에 기대지 않으므로, 이 디렉토리가 지식 저장소에 `.onto/`로 복사되어도 그대로 돈다.
# `--locked`는 uv.lock과 pyproject.toml이 어긋나면 실행하지 않고 알린다(잠금 파일을 몰래 고치지 않는다).
tool := "uv run --locked --quiet --project " + quote(source_directory()) + " python -P -X utf8 -m onto_tool"

# 레시피 없이 `just onto`나 `just -f .onto/Justfile`만 부르면 명령 목록을 보여 준다. 첫 레시피인 build가 파일을 쓰지 않게 한다.
[private]
default:
    @"{{just_executable()}}" --justfile "{{source_file()}}" --list

# 지식 저장소의 페이지를 그래프로 컴파일하고 추론해 이 디렉토리의 .build/graph.ttl로 남긴다. 모든 지식 저장소를 모은 전체 인덱스도 이 디렉토리의 .build/index.md로 남긴다.
# 지식 저장소의 온톨로지 층에는 그 저장소의 인덱스(docs/ontology/index.md)를 만든다. 인덱스는 생성물이지만 커밋하는 파일이다. 그 밖에는 저장소의 작업 트리에 아무것도 만들지 않는다.
[no-exit-message]
build *args:
    @{{tool}} build "$@"

# 문제는 한 줄에 하나, 탭으로 나눈 다섯 칸(심각도, 지식 저장소, 페이지, 검사 항목, 설명)으로 보고한다. 문제가 없으면 아무것도 출력하지 않는다.
# 스크립트 검사. 지식 저장소의 페이지를 구조 제약, 참조, 중복 같은 검사 항목으로 기계적으로 검사한다. 실행할 때마다 현재 파일에서 다시 컴파일하며 이전 build의 결과를 쓰지 않고, 어떤 파일도 고치지 않는다. 오류가 하나라도 있으면 0이 아닌 종료 코드로 끝나고 경고만 있으면 0이다.
[no-exit-message]
validate *args:
    @{{tool}} validate "$@"

# 예: just onto query 'SELECT ?e ?t WHERE { ?e dcterms:title ?t }'
# SPARQL 질의를 실행한다. 하위 클래스, 역관계, 추이 관계가 추론된 그래프를 질의한다. 실행할 때마다 현재 파일에서 다시 컴파일하며, 이전 build의 결과를 쓰지 않는다.
[no-exit-message]
query *args:
    @{{tool}} query "$@"
