# repo 모듈: 지식 저장소의 등록과 제거.
# 모듈의 명령은 모듈 파일이 있는 디렉토리가 아니라 루트 저장소에서 실행한다.
set working-directory := '..'

# 공개 원본의 주소. 접속 방식과 `.git`을 뺀 `호스트/소유자/저장소`를 소문자로 적는다.
# 루트 저장소의 `origin`이 이 저장소이면 `add`가 거부한다(docs/adr/0007).
public_origin := "github.com/powerumc/ontology"

# add: 지식 저장소를 projects/<이름>/에 서브모듈로 등록하고 추적 브랜치를 기록한다.
# 이름을 생략하면 URL의 저장소 이름을, 브랜치를 생략하면 원격의 기본 브랜치를 쓴다.
# 등록은 루트 저장소에 스테이징까지만 한다. 커밋은 사용자가 한다.

# 지식 저장소를 projects/<이름>/에 서브모듈로 붙인다: just repo add <url> [이름] [브랜치]
[no-exit-message]
[positional-arguments]
add url name='' branch='':
    #!/usr/bin/env sh
    set -eu

    die() {
        echo "오류: $*" >&2
        exit 1
    }

    # 저장소 주소를 `호스트/소유자/저장소` 꼴로 줄인다. ssh와 https, `.git` 유무, 포트와 계정, 대소문자가 달라도 같은 값이 된다.
    normalize() {
        u=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
        case $u in
            *://*)  # scheme://[계정@]호스트[:포트]/경로
                rest=${u#*://}
                authority=${rest%%/*}
                host=${authority##*@}
                u=${host%%:*}${rest#"$authority"}
                ;;
            /* | ./* | ../*) ;;  # 로컬 경로
            *:*)  # scp 꼴: [계정@]호스트:경로
                host=${u%%:*}
                u=${host##*@}/${u#*:}
                ;;
        esac
        u=${u%/}
        u=${u%.git}
        printf '%s\n' "${u%/}"
    }

    # .gitmodules에서 경로가 $1인 항목의 서브모듈 이름을 찾는다. 없으면 아무것도 출력하지 않는다.
    gitmodules_name_of() {
        [ -f .gitmodules ] || return 0
        git config -f .gitmodules --name-only --get-regexp '^submodule\..*\.path$' |
            while IFS= read -r key; do
                if [ "$(git config -f .gitmodules --get "$key")" = "$1" ]; then
                    sub=${key#submodule.}
                    printf '%s\n' "${sub%.path}"
                    break
                fi
            done
    }

    url=$1
    name=$2
    branch=$3

    # --- 공개 원본에는 등록하지 않는다. 받아 올 주소와 푸시할 주소를 모두 본다 ---
    public=$(normalize "{{public_origin}}")
    origin_urls=$(git remote get-url --all origin 2>/dev/null || true)
    push_urls=$(git remote get-url --push --all origin 2>/dev/null || true)
    while IFS= read -r origin_url; do
        [ -n "$origin_url" ] || continue
        if [ "$(normalize "$origin_url")" = "$public" ]; then
            die "이 저장소의 origin이 공개 원본($origin_url)입니다. 공개 원본에는 지식 저장소를 등록하지 않습니다. 이 저장소를 받아 origin을 자기 원격으로 바꾼 뒤 등록하세요. (docs/adr/0007)"
        fi
    done <<EOF
    $origin_urls
    $push_urls
    EOF

    case $url in
        -*) die "URL이 올바르지 않습니다: $url" ;;
    esac

    # --- 이름: 생략하면 URL의 마지막 조각에서 `.git`을 뗀 것 ---
    if [ -z "$name" ]; then
        name=${url%/}
        name=${name%.git}
        name=${name%/}
        name=${name##*[/:]}
        [ -n "$name" ] || die "URL에서 저장소 이름을 알 수 없습니다. 이름을 지정하세요: just repo add <url> <이름>"
    fi
    # projects/ 바로 아래의 디렉토리 이름이어야 한다. 경로 조각이나 옵션처럼 읽히는 이름은 받지 않는다.
    case $name in
        . | .. | -* | */*) die "이름이 올바르지 않습니다: '$name'. projects/ 바로 아래의 디렉토리 이름이어야 합니다." ;;
    esac
    path=projects/$name

    # --- 같은 이름이 이미 있으면 아무것도 바꾸지 않고 거부한다. 원격에 접속하기 전에 본다 ---
    if [ -f .gitmodules ]; then
        git config -f .gitmodules --list >/dev/null || die ".gitmodules를 읽지 못했습니다"
    fi
    if [ -n "$(git -c core.quotePath=false --literal-pathspecs ls-files -- "$path")" ] ||
        [ -n "$(gitmodules_name_of "$path")" ]; then
        die "$path 가 이미 등록되어 있습니다."
    fi
    if [ -e "$path" ] || [ -L "$path" ]; then
        die "$path 가 이미 있습니다. 같은 이름의 디렉토리나 파일이 있어 등록하지 않았습니다."
    fi
    modules_dir=$(git rev-parse --git-path "modules/$path")
    if [ -e "$modules_dir" ]; then
        die "이전에 등록했던 서브모듈 저장소가 $modules_dir 에 이미 남아 있습니다. 필요 없으면 지우고 다시 등록하세요."
    fi

    # --- 원격 확인: 접속할 수 있는지, 추적 브랜치가 있는지 먼저 본다 ---
    # 없는 브랜치로 `git submodule add -b`를 하면 projects/<이름>/와 .git/modules가 반쯤 남는다.
    if [ -z "$branch" ]; then
        refs=$(git ls-remote --symref -- "$url" HEAD) || die "원격에 접속하지 못했습니다: $url"
        branch=$(printf '%s\n' "$refs" | awk '$1 == "ref:" { sub("^refs/heads/", "", $2); print $2; exit }')
        [ -n "$branch" ] || die "원격의 기본 브랜치를 알 수 없습니다. 브랜치를 지정하세요: just repo add <url> <이름> <브랜치>"
    fi
    heads=$(git ls-remote --heads -- "$url" "refs/heads/$branch") || die "원격에 접속하지 못했습니다: $url"
    if ! printf '%s\n' "$heads" | awk -v ref="refs/heads/$branch" '$2 == ref { found = 1 } END { exit !found }'; then
        die "원격에 $branch 브랜치가 없습니다: $url"
    fi

    # 복제가 실패하면 git이 서브모듈 디렉토리는 치우지만, 만들어 둔 빈 projects/는 남긴다.
    had_projects=0
    if [ -d projects ]; then
        had_projects=1
    fi
    # 커밋된 등록을 지운 뒤에는 .gitmodules가 작업 트리에 없고 HEAD에만 있다. 그러면 git이 쓰기를 거부하므로 빈 파일을 둔다.
    created_gitmodules=0
    if [ ! -e .gitmodules ]; then
        : >.gitmodules
        created_gitmodules=1
    fi
    if ! git submodule add -b "$branch" -- "$url" "$path"; then
        if [ "$created_gitmodules" = 1 ]; then
            rm -f .gitmodules
        fi
        if [ "$had_projects" = 0 ]; then
            rmdir projects 2>/dev/null || true
        fi
        die "$path 에 등록하지 못했습니다."
    fi
    # 등록 직후의 기능 복사(`onto sync <이름>`)는 #12에서 여기에 붙인다.
    echo "등록했습니다: $path (추적 브랜치: $branch). 루트 저장소에 스테이징만 했습니다. 커밋은 직접 하세요."

# remove: 지식 저장소를 서브모듈의 흔적까지 완전히 제거한다. 작업 트리, 등록 정보, .git/modules의 저장소가 모두 사라진다.
# 미커밋 변경, 원격에 없는 커밋(어느 로컬 브랜치든), 스태시가 있으면 이유와 함께 거부한다. --force를 주면 버리고 제거한다.
# 제거는 루트 저장소에 스테이징까지만 한다. 커밋은 사용자가 한다.

# 지식 저장소를 완전히 제거한다. 버려질 작업이 있으면 거부한다: just repo remove <이름> [--force]
[no-exit-message]
[positional-arguments]
remove *args:
    #!/usr/bin/env sh
    set -eu

    die() {
        echo "오류: $*" >&2
        exit 1
    }

    usage="사용법: just repo remove <이름> [--force]"
    force=0
    name=
    for arg in "$@"; do
        case $arg in
            --force | -f) force=1 ;;
            -*) die "알 수 없는 옵션입니다: $arg. $usage" ;;
            *)
                [ -z "$name" ] || die "이름은 하나만 줄 수 있습니다. $usage"
                name=$arg
                ;;
        esac
    done
    [ -n "$name" ] || die "제거할 이름을 주세요. $usage"
    path=projects/$name

    # .gitmodules에서 경로가 $1인 항목의 서브모듈 이름을 찾는다. 없으면 아무것도 출력하지 않는다.
    gitmodules_name_of() {
        [ -f .gitmodules ] || return 0
        git config -f .gitmodules --name-only --get-regexp '^submodule\..*\.path$' |
            while IFS= read -r key; do
                if [ "$(git config -f .gitmodules --get "$key")" = "$1" ]; then
                    sub=${key#submodule.}
                    printf '%s\n' "${sub%.path}"
                    break
                fi
            done
    }

    # --- 등록된 지식 저장소인지: 루트가 기록한 커밋(gitlink)이나 .gitmodules 항목이 있어야 한다 ---
    # 등록되지 않은 디렉토리는 이름이 같아도 지우지 않는다.
    if [ -f .gitmodules ]; then
        git config -f .gitmodules --list >/dev/null || die ".gitmodules를 읽지 못했습니다"
    fi
    sub_name=$(gitmodules_name_of "$path")
    has_gitlink=0
    if git -c core.quotePath=false --literal-pathspecs ls-files --stage -- "$path" |
        awk -F '\t' -v path="$path" '$1 ~ /^160000 / && $2 == path { found = 1 } END { exit !found }'; then
        has_gitlink=1
    fi
    if [ -z "$sub_name" ] && [ "$has_gitlink" = 0 ]; then
        die "등록된 지식 저장소가 아닙니다: $name"
    fi
    [ -n "$sub_name" ] || sub_name=$path

    # --- 버려질 작업이 있는지 ---
    dirty=
    stashes=
    unpushed_refs=
    detached_commits=0
    unreadable=0
    stray=0
    if [ -e "$path/.git" ]; then
        # 서브모듈 저장소의 상태를 읽는다. 읽지 못하면 있는 것으로 본다.
        # `-C`로 들어간 곳이 서브모듈 저장소가 아니면(--show-prefix가 비어 있지 않으면) 루트 저장소를 읽게 된다.
        prefix=$(git -C "$path" rev-parse --show-prefix 2>/dev/null) || prefix=unreadable
        if [ -n "$prefix" ]; then
            unreadable=1
        else
            dirty=$(git -C "$path" -c core.quotePath=false status --porcelain --untracked-files=all) || unreadable=1
            stashes=$(git -C "$path" stash list) || unreadable=1
            # 원격 추적 브랜치(refs/remotes)에 없는 커밋이 있는 로컬 브랜치
            for ref in $(git -C "$path" for-each-ref --format='%(refname)' refs/heads); do
                count=$(git -C "$path" rev-list --count "$ref" --not --remotes) || count=1
                if [ "$count" -gt 0 ]; then
                    unpushed_refs="$unpushed_refs $ref"
                fi
            done
            # 브랜치에 속하지 않는 HEAD의 커밋(detached HEAD에서 쌓은 것)
            detached_commits=$(git -C "$path" rev-list --count HEAD --not --branches --remotes 2>/dev/null) || detached_commits=0
        fi
    elif [ -d "$path" ] && [ -n "$(ls -A "$path")" ]; then
        stray=1  # 서브모듈이 초기화되지 않았는데 사용자의 파일이 들어 있다
    fi

    have_work=0
    if [ -n "$dirty" ] || [ -n "$stashes" ] || [ -n "$unpushed_refs" ] || [ "$detached_commits" -gt 0 ] ||
        [ "$unreadable" = 1 ] || [ "$stray" = 1 ]; then
        have_work=1
    fi

    # 버려질 것의 목록. 커밋은 브랜치마다 열 개까지만 보인다.
    report() {
        if [ "$unreadable" = 1 ]; then
            echo "  서브모듈 저장소의 상태를 읽지 못했습니다. 버려지는 것이 있는지 알 수 없습니다."
        fi
        if [ "$stray" = 1 ]; then
            echo "  서브모듈이 아직 초기화되지 않았는데 $path 에 파일이 있습니다."
        fi
        if [ -n "$dirty" ]; then
            total=$(printf '%s\n' "$dirty" | wc -l | tr -d ' ')
            echo "  미커밋 변경 (${total}개):"
            printf '%s\n' "$dirty" | head -n 20 | sed 's/^/    /'
            if [ "$total" -gt 20 ]; then
                echo "    … 외 $((total - 20))개"
            fi
        fi
        if [ -n "$unpushed_refs" ] || [ "$detached_commits" -gt 0 ]; then
            echo "  원격에 없는 커밋:"
            for ref in $unpushed_refs; do
                total=$(git -C "$path" rev-list --count "$ref" --not --remotes)
                echo "    ${ref#refs/heads/}: ${total}개"
                git -C "$path" log -n 10 "$ref" --not --remotes --format='      %h %s'
                if [ "$total" -gt 10 ]; then
                    echo "      … 외 $((total - 10))개"
                fi
            done
            if [ "$detached_commits" -gt 0 ]; then
                echo "    (detached HEAD): ${detached_commits}개"
                git -C "$path" log -n 10 HEAD --not --branches --remotes --format='      %h %s'
                if [ "$detached_commits" -gt 10 ]; then
                    echo "      … 외 $((detached_commits - 10))개"
                fi
            fi
        fi
        if [ -n "$stashes" ]; then
            echo "  스태시 ($(printf '%s\n' "$stashes" | wc -l | tr -d ' ')개)"
        fi
    }

    if [ "$have_work" = 1 ]; then
        if [ "$force" = 0 ]; then
            case $name in
                *[[:space:]]*) shown="'$name'" ;;
                *) shown=$name ;;
            esac
            echo "오류: $path 에 버려질 작업이 있어 제거하지 않았습니다. 아무것도 바꾸지 않았습니다." >&2
            report >&2
            echo "이 작업을 버려도 되면 강제 옵션을 주세요: just repo remove $shown --force" >&2
            exit 1
        fi
        echo "강제 옵션: 다음 작업을 버리고 $path 를 제거합니다."
        report
    fi

    # --- 제거: 작업 트리, 루트의 등록 정보, .git/modules의 서브모듈 저장소 ---
    # `git rm`과 `git submodule deinit`은 .gitmodules의 상태에 따라 거부하는 경우가 있어, 조각을 하나씩 직접 지운다.
    modules_dir=$(git rev-parse --git-path "modules/$sub_name")
    if [ "$has_gitlink" = 1 ]; then
        git update-index --force-remove -- "$path"
    fi
    if [ -n "$(gitmodules_name_of "$path")" ]; then
        git config -f .gitmodules --remove-section "submodule.$sub_name"
        git add -- .gitmodules
    fi
    rm -rf -- "$path"
    git config --remove-section "submodule.$sub_name" 2>/dev/null || true
    case $modules_dir in
        */modules/?*) rm -rf -- "$modules_dir" ;;
    esac
    # 마지막 항목을 지웠다면 빈 .gitmodules와 빈 projects/도 남기지 않는다.
    if [ -f .gitmodules ] && [ -z "$(git config -f .gitmodules --list)" ]; then
        if git ls-files --error-unmatch -- .gitmodules >/dev/null 2>&1; then
            git rm -f -q -- .gitmodules
        else
            rm -f .gitmodules
        fi
    fi
    rmdir projects 2>/dev/null || true

    echo "제거했습니다: $path. 루트 저장소에 스테이징만 했습니다. 커밋은 직접 하세요."
